# Copy this file to .env and fill in real values. Never commit .env.
# The backend reads these via python-dotenv on startup.

# ═══════════════════════════════════════════════════════════════
# Gemini API key (https://aistudio.google.com/apikey)
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=

# Override default Gemini model if needed.
# Defaults: gemini-2.5-flash. Cheaper option: gemini-2.5-flash-lite.
# GEMINI_MODEL=gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════
# Deployment URLs
# ═══════════════════════════════════════════════════════════════
# Frontend → backend URL (used by Next.js at BUILD time)
# For local dev: http://localhost:8000
# For production: https://YOUR_DOMAIN/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
# For local dev: http://localhost:3000,http://127.0.0.1:3000
# For production: https://YOUR_DOMAIN
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
